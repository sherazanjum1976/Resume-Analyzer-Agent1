# Copy this file to .streamlit/secrets.toml for LOCAL use only.
# Never commit the real secrets.toml file to GitHub.
#
# On Streamlit Community Cloud, do NOT upload this file at all.
# Instead, paste these same keys into:
#   App settings → Secrets (in the Streamlit Cloud dashboard)

GROQ_API_KEY = "your-groq-api-key-here"

# Optional — defaults to "openai/gpt-oss-120b" if not set.
GROQ_MODEL = "openai/gpt-oss-120b"
